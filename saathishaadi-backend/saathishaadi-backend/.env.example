PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/saathishaadi

# JWT - Strong 256-bit secret
JWT_SECRET=your_super_secret_jwt_key_minimum_64_characters_long_change_this
JWT_EXPIRES_IN=30d

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=YourStrongAdminPassword@2025

# Frontend URLs (CORS)
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Cloudflare / Production Security
# Local development me false rakhein. Production me Cloudflare proxy enable karne ke baad true karein.
CLOUDFLARE_ONLY=false

# Email Config (Gmail / SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=SaathiShaadi <noreply@saathishaadi.com>
EMAIL_LOGO_URL=http://localhost:3000/logo.png
EMAIL_LOGO_PATH=../../saathishaadi-frontend/src/assest/logo.png

# Security
ENCRYPTION_KEY=32_char_hex_key_change_this_now!!
NODE_ENV=development
